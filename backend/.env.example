# PolarOps Backend Environment Variables Example
PROJECT_NAME="PolarOps Command Center"
SECRET_KEY="your_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL Credentials
POSTGRES_USER=polaradmin
POSTGRES_PASSWORD=polarpassword
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polarops

# Direct Database URL (Optional override)
# DATABASE_URL=postgresql://polaradmin:polarpassword@localhost:5432/polarops
